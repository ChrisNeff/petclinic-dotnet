@page
@model PetClinic.Web.Pages.Vets.IndexModel
@{
    ViewData["Title"] = "Veterinarians";
}

<h2 class="text-2xl font-bold text-navy mb-1">Veterinarians</h2>
<div class="w-10 h-1 rounded bg-cyan mb-6"></div>

@if (!Model.Vets.Any())
{
    <p class="text-gray-400 italic">No veterinarians found.</p>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var vet in Model.Vets)
        {
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                <h5 class="font-bold text-navy mb-2">@vet.FullName</h5>
                @if (vet.VetSpecialties.Any())
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var vs in vet.VetSpecialties)
                        {
                            <span class="text-xs bg-brand text-white px-2 py-0.5 rounded-full">@vs.Specialty.Name</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-xs text-gray-400 italic">No specialties</span>
                }
            </div>
        }
    </div>
}

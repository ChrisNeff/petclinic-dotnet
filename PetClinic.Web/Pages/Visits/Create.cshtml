@page
@model PetClinic.Web.Pages.Visits.CreateModel
@{
    ViewData["Title"] = "Add Visit";
}

<h2>Add Visit for @Model.PetName</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Visit.PetId" type="hidden" />

            <div class="mb-3">
                <label asp-for="Visit.VisitDate" class="form-label"></label>
                <input asp-for="Visit.VisitDate" type="date" class="form-control" />
                <span asp-validation-for="Visit.VisitDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Visit.Description" class="form-label"></label>
                <textarea asp-for="Visit.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Visit.Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-page="/Owners/Detail" asp-route-id="@Model.OwnerId" class="btn btn-outline-secondary ms-1">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

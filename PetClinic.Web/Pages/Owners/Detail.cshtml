@page "{id:int}"
@model PetClinic.Web.Pages.Owners.DetailModel
@{
    ViewData["Title"] = Model.Owner?.FullName ?? "Owner";
}

@if (Model.Owner == null)
{
    <div class="alert alert-warning">Owner not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back</a>
    return;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <h2>@Model.Owner.FullName</h2>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Owner.Id" class="btn btn-outline-secondary">Edit Owner</a>
        <a asp-page="./Index" class="btn btn-outline-secondary ms-1">Back</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Owner.Address</dd>
            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@Model.Owner.City</dd>
            <dt class="col-sm-3">Telephone</dt>
            <dd class="col-sm-9">@Model.Owner.Telephone</dd>
        </dl>
    </div>
</div>

<h4>Pets</h4>

@if (!Model.Owner.Pets.Any())
{
    <p class="text-muted">No pets registered.</p>
}
else
{
    @foreach (var pet in Model.Owner.Pets)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <strong>@pet.Name</strong>
                <div>
                    <a asp-page="/Pets/Edit" asp-route-id="@pet.Id" class="btn btn-sm btn-outline-secondary">Edit Pet</a>
                    <a asp-page="/Visits/Create" asp-route-petId="@pet.Id" class="btn btn-sm btn-success ms-1">Add Visit</a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">@pet.PetType.Name</dd>
                    <dt class="col-sm-3">Birth Date</dt>
                    <dd class="col-sm-9">@pet.BirthDate.ToString("yyyy-MM-dd")</dd>
                </dl>
                @if (pet.Visits.Any())
                {
                    <h6 class="mt-3">Visit History</h6>
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Description</th></tr></thead>
                        <tbody>
                            @foreach (var visit in pet.Visits.OrderByDescending(v => v.VisitDate))
                            {
                                <tr>
                                    <td>@visit.VisitDate.ToString("yyyy-MM-dd")</td>
                                    <td>@visit.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

<a asp-page="/Pets/Create" asp-route-ownerId="@Model.Owner.Id" class="btn btn-success">Add Pet</a>

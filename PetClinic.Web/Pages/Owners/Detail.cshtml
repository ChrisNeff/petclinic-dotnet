@page "{id:int}"
@model PetClinic.Web.Pages.Owners.DetailModel
@{
    ViewData["Title"] = Model.Owner?.FullName ?? "Owner";
}

@if (Model.Owner == null)
{
    <p class="text-gray-400 italic">Owner not found.</p>
    <a asp-page="./Index" class="text-brand hover:text-navy text-sm mt-2 inline-block">← Back to owners</a>
    return;
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-2xl font-bold text-navy">@Model.Owner.FullName</h2>
        <div class="w-12 h-1 rounded bg-cyan mt-1"></div>
    </div>
    <div class="flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Owner.Id"
           class="border border-gray-300 text-gray-600 hover:border-brand hover:text-brand text-sm px-4 py-1.5 rounded transition-colors">Edit Owner</a>
        <a asp-page="./Index"
           class="border border-gray-300 text-gray-600 hover:border-brand hover:text-brand text-sm px-4 py-1.5 rounded transition-colors">← Back</a>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 mb-8 grid grid-cols-2 gap-4 text-sm max-w-xl">
    <span class="font-semibold text-navy">Address</span><span class="text-gray-600">@Model.Owner.Address</span>
    <span class="font-semibold text-navy">City</span><span class="text-gray-600">@Model.Owner.City</span>
    <span class="font-semibold text-navy">Telephone</span><span class="text-gray-600">@Model.Owner.Telephone</span>
</div>

<div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-navy">Pets</h3>
    <a asp-page="/Pets/Create" asp-route-ownerId="@Model.Owner.Id"
       class="bg-brand hover:bg-navy text-white text-sm font-semibold px-4 py-1.5 rounded transition-colors">Add Pet</a>
</div>

@if (!Model.Owner.Pets.Any())
{
    <p class="text-gray-400 italic text-sm">No pets registered.</p>
}
else
{
    @foreach (var pet in Model.Owner.Pets)
    {
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 mb-4 overflow-hidden">
            <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100 bg-light">
                <span class="font-bold text-navy">@pet.Name</span>
                <div class="flex gap-2">
                    <a asp-page="/Pets/Edit" asp-route-id="@pet.Id"
                       class="text-xs border border-gray-300 text-gray-600 hover:border-brand hover:text-brand px-3 py-1 rounded transition-colors">Edit</a>
                    <a asp-page="/Visits/Create" asp-route-petId="@pet.Id"
                       class="text-xs bg-brand hover:bg-navy text-white px-3 py-1 rounded transition-colors">Add Visit</a>
                </div>
            </div>
            <div class="px-5 py-4 text-sm">
                <div class="grid grid-cols-2 gap-2 max-w-xs mb-3">
                    <span class="font-semibold text-navy">Type</span><span class="text-gray-600">@pet.PetType.Name</span>
                    <span class="font-semibold text-navy">Birth Date</span><span class="text-gray-600">@pet.BirthDate.ToString("yyyy-MM-dd")</span>
                </div>
                @if (pet.Visits.Any())
                {
                    <h6 class="font-semibold text-navy text-xs uppercase tracking-wide mb-2">Visit History</h6>
                    <table class="w-full text-xs">
                        <thead>
                            <tr class="text-gray-400 border-b border-gray-100">
                                <th class="text-left pb-1 font-medium">Date</th>
                                <th class="text-left pb-1 font-medium">Description</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            @foreach (var visit in pet.Visits.OrderByDescending(v => v.VisitDate))
                            {
                                <tr>
                                    <td class="py-1 text-gray-500 w-28">@visit.VisitDate.ToString("yyyy-MM-dd")</td>
                                    <td class="py-1 text-gray-700">@visit.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

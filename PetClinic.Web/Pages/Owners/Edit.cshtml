@page "{id:int}"
@model PetClinic.Web.Pages.Owners.EditModel
@{
    ViewData["Title"] = "Edit Owner";
}

<h2 class="text-2xl font-bold text-navy mb-1">Edit Owner</h2>
<div class="w-10 h-1 rounded bg-cyan mb-6"></div>

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 max-w-lg">
    <form method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
        <input asp-for="Owner.Id" type="hidden" />

        <div>
            <label asp-for="Owner.FirstName" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Owner.FirstName" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Owner.FirstName" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Owner.LastName" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Owner.LastName" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Owner.LastName" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Owner.Address" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Owner.Address" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Owner.Address" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Owner.City" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Owner.City" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Owner.City" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Owner.Telephone" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Owner.Telephone" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Owner.Telephone" class="text-red-500 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="bg-brand hover:bg-navy text-white font-semibold text-sm px-5 py-2 rounded transition-colors">Save</button>
            <a asp-page="./Detail" asp-route-id="@Model.Owner.Id" class="border border-gray-300 text-gray-600 hover:border-brand hover:text-brand text-sm px-5 py-2 rounded transition-colors">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

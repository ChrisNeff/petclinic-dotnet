@page
@model PetClinic.Web.Pages.Owners.IndexModel
@{
    ViewData["Title"] = "Owners";
}

<h2>Owners</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="lastName" value="@Model.LastName" class="form-control" placeholder="Search by last name…" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Find Owners</button>
        <a asp-page="./Index" class="btn btn-outline-secondary ms-1">Clear</a>
    </div>
</form>

@if (Model.Owners.Count == 0)
{
    <div class="alert alert-info">No owners found.</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-success">
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>Telephone</th>
                <th>Pets</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owner in Model.Owners)
            {
                <tr>
                    <td>
                        <a asp-page="./Detail" asp-route-id="@owner.Id">@owner.FullName</a>
                    </td>
                    <td>@owner.Address</td>
                    <td>@owner.City</td>
                    <td>@owner.Telephone</td>
                    <td>@string.Join(", ", owner.Pets.Select(p => p.Name))</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@owner.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="./Create" class="btn btn-success mt-2">Add Owner</a>

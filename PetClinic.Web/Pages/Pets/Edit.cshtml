@page "{id:int}"
@model PetClinic.Web.Pages.Pets.EditModel
@{
    ViewData["Title"] = "Edit Pet";
}

<h2>Edit Pet</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Pet.Id" type="hidden" />
            <input asp-for="Pet.OwnerId" type="hidden" />

            <div class="mb-3">
                <label asp-for="Pet.Name" class="form-label"></label>
                <input asp-for="Pet.Name" class="form-control" />
                <span asp-validation-for="Pet.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Pet.BirthDate" class="form-label"></label>
                <input asp-for="Pet.BirthDate" type="date" class="form-control" />
                <span asp-validation-for="Pet.BirthDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Pet.PetTypeId" class="form-label">Type</label>
                <select asp-for="Pet.PetTypeId" asp-items="Model.PetTypes" class="form-select"></select>
                <span asp-validation-for="Pet.PetTypeId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-page="/Owners/Detail" asp-route-id="@Model.Pet.OwnerId" class="btn btn-outline-secondary ms-1">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

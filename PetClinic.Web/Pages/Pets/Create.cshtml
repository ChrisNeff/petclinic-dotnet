@page
@model PetClinic.Web.Pages.Pets.CreateModel
@{
    ViewData["Title"] = "Add Pet";
}

<h2 class="text-2xl font-bold text-navy mb-1">Add Pet</h2>
<div class="w-10 h-1 rounded bg-cyan mb-6"></div>

<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 max-w-lg">
    <form method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
        <input asp-for="Pet.OwnerId" type="hidden" />

        <div>
            <label asp-for="Pet.Name" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Pet.Name" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Pet.Name" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Pet.BirthDate" class="block text-sm font-medium text-navy mb-1"></label>
            <input asp-for="Pet.BirthDate" type="date" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
            <span asp-validation-for="Pet.BirthDate" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Pet.PetTypeId" class="block text-sm font-medium text-navy mb-1">Type</label>
            <select asp-for="Pet.PetTypeId" asp-items="Model.PetTypes"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand">
                <option value="">-- Select type --</option>
            </select>
            <span asp-validation-for="Pet.PetTypeId" class="text-red-500 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="bg-brand hover:bg-navy text-white font-semibold text-sm px-5 py-2 rounded transition-colors">Save</button>
            <a asp-page="/Owners/Detail" asp-route-id="@Model.Pet.OwnerId" class="border border-gray-300 text-gray-600 hover:border-brand hover:text-brand text-sm px-5 py-2 rounded transition-colors">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetClinic</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy:   '#005a87',
                        brand:  '#007cba',
                        cyan:   '#31cdcf',
                        purple: '#7a00df',
                        light:  '#f4f6f8',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-light min-h-screen flex flex-col text-gray-800">

    <nav class="bg-navy text-white shadow">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <a asp-page="/Index" class="text-xl font-bold tracking-tight text-white hover:text-cyan transition-colors">
                PetClinic
            </a>
            <div class="flex gap-6 text-sm font-medium">
                <a asp-page="/Index"         class="hover:text-cyan transition-colors">Home</a>
                <a asp-page="/Owners/Index"  class="hover:text-cyan transition-colors">Owners</a>
                <a asp-page="/Vets/Index"    class="hover:text-cyan transition-colors">Veterinarians</a>
                <a href="/swagger"           class="hover:text-cyan transition-colors">API</a>
            </div>
        </div>
    </nav>

    <div class="max-w-6xl mx-auto w-full px-4 py-8 flex-1">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-gray-200 py-4 text-center text-sm text-gray-400">
        PetClinic — .NET port of the Spring PetClinic sample
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
